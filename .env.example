# Copy to .env and adjust — `docker compose` reads it automatically.
# Every value below is optional; the defaults match a local setup.

# Public URL baked into QR codes. Change it when serving from another host.
PUBLIC_BASE_URL=http://localhost:6270

# ── OIDC login (optional) ──
# Sign admins in through any OIDC provider that exposes discovery (Authelia,
# Keycloak, Authentik, Okta, Entra ID, …). Register a confidential client whose
# redirect URI is <PUBLIC_BASE_URL>/api/auth/oidc/callback, then uncomment and
# restart `docker compose`.
# The first OIDC user ever becomes admin; later users must already exist or be
# listed in OIDC_ADMIN_EMAILS.
# OIDC_ENABLED=true
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=slides
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URL=http://localhost:6270/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile groups
# OIDC_ADMIN_EMAILS=you@example.com,teammate@example.com

# ── analytics profile (docker compose --profile analytics up -d) ──
# Umami runs at http://localhost:6271 (first login: admin / umami).
# Create a website there, then paste its script URL and website id into
# Slides → Admin → Analytics.
UMAMI_DB_PASSWORD=umami
UMAMI_APP_SECRET=change-me

# ── email / SMTP (optional; env overrides DB settings) ──
# Used for password-reset emails. Configure via Admin → Settings or env.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=noreply@example.com
# SMTP_TLS=starttls  # starttls|ssl|none

# ── webhooks (optional; env overrides DB settings) ──
# WEBHOOK_URL=https://hooks.example.com/slides
# WEBHOOK_SECRET=change-me
# WEBHOOK_ENABLED=true
# WEBHOOK_EVENTS=qa.created,question.activated,question.closed,event.closed
# WEBHOOK_ALLOW_PRIVATE=0  # set to 1 to allow private/loopback hosts

# ── observability profile (docker compose --profile observability up -d) ──
# Empty disables OpenTelemetry. When the collector profile is running, use:
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=slides

# Seed a deterministic "feature-test" event (code "feature-test") on startup so
# the bundled feature-test deck auto-connects. Set by the published image.
# SEED_FEATURE_TEST=1

# Seed live quiz questions from each deck's questions.json (built from slides.md)
# into the DB on container startup. Re-runs update in place without duplicating.
# SEED_DECK_QUESTIONS=1
